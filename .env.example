# Supabase project URL and public client key.
# Obtain these from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional privileged key. Use only in server-only code when genuinely required.
# Never prefix this with NEXT_PUBLIC_ and never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary public cloud name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Server-side Cloudinary credentials. Keep these secret.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
